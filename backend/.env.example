STOCK_DB_HOST=127.0.0.1
STOCK_DB_PORT=3306
STOCK_DB_USER=root
STOCK_DB_PASSWORD=
STOCK_DB_NAME=hermes-stock
STOCK_DB_ECHO=false
STOCK_CORS_ORIGINS=*

# Optional full SQLAlchemy URL. If set, it overrides STOCK_DB_*.
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/hermes-stock?charset=utf8mb4

# Initial admin bootstrap (NOT hardcoded). An initial super_admin is created only when
# BOTH are set here AND the users table is empty. Leave unset to create no default account.
# STOCK_ADMIN_USERNAME=
# STOCK_ADMIN_PASSWORD=

# Encryption key for Feishu webhook URL/secret at rest (recommended: a long random string).
# If unset, a key is derived from STOCK_AUTH_SECRET / DB password as a fallback.
# STOCK_WEBHOOK_ENC_KEY=

# Daily-rhythm scheduler. Server timezone should be Asia/Shanghai; deploy with a single uvicorn worker.
# STOCK_SCHEDULER_ENABLED=true
# STOCK_SCHEDULER_TICK_SECONDS=30
# Keep true for a single-process installation. In the HA layout, only the
# dedicated background service sets this true; public API replicas set it false.
# STOCK_BACKGROUND_SERVICES_ENABLED=true
# Comma-separated CN market holidays (YYYY-MM-DD) that suppress intraday/trading-day-only jobs.
# STOCK_HOLIDAYS=2026-01-01,2026-02-16,2026-02-17

# Vector-memory embeddings (decoupled from the chat LLM). If unset, memory falls back to the
# active LLM provider's /embeddings; if that provider has no embeddings endpoint, memory
# gracefully disables. Point these at any OpenAI-compatible /embeddings service, e.g. SiliconFlow.
# STOCK_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# STOCK_EMBEDDING_API_KEY=
# STOCK_EMBEDDING_MODEL=BAAI/bge-m3
# Optional reranker for memory retrieval (recall -> rerank). Reuses the embedding base_url/api_key
# (same provider's /rerank endpoint). Leave empty to disable reranking.
# STOCK_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Tavily supports a primary key plus a fallback pool. Keep the legacy single-key
# setting as the primary; add comma/newline-separated backup keys to the plural setting.
# STOCK_TAVILY_API_KEY=
# STOCK_TAVILY_API_KEYS=

# Vector store backend for memory: chroma (embedded, default; works on Windows) or milvus (server).
# For milvus, deploy Milvus standalone and point the URI at it (localhost by default).
# STOCK_VECTOR_BACKEND=chroma
# Keep embedded Chroma data outside release directories so a deployment cannot discard it.
# STOCK_CHROMA_DIR=/opt/hermes-stock/shared/chroma
# STOCK_EXP_CHROMA_DIR=/opt/hermes-stock/shared/chroma_exp
# STOCK_MILVUS_URI=http://127.0.0.1:19530
# STOCK_MILVUS_TOKEN=
# STOCK_RAG_MILVUS_COLLECTION=knowledge_chunks
# STOCK_EXP_MILVUS_COLLECTION=experience_entries

# Agent workspace. Production execution uses the dedicated Docker broker; never
# add the public API account to the docker group and never mount docker.sock into it.
# STOCK_WORKSPACE_ENABLED=true
# STOCK_WORKSPACE_DIR=/opt/hermes-stock/workspace
# STOCK_WORKSPACE_EXEC_ENABLED=false
# STOCK_WORKSPACE_EXEC_BACKEND=docker
# STOCK_WORKSPACE_EXEC_SOCKET=/run/hermes-stock-sandbox/sandbox.sock
# STOCK_WORKSPACE_EXEC_IMAGE=hermes-stock-python-sandbox:latest
# STOCK_WORKSPACE_EXEC_MEMORY=1g
# STOCK_WORKSPACE_EXEC_CPUS=2
# STOCK_WORKSPACE_EXEC_PIDS_LIMIT=128
# STOCK_WORKSPACE_EXEC_WORKSPACE_BYTES=268435456
# STOCK_WORKSPACE_EXEC_WORKSPACE_FILES=2000
# STOCK_WORKSPACE_EXEC_MAX_CONCURRENCY=4

# Durable Agent runtime. The background service should run the worker; public
# API replicas only create runs and replay persisted events.
# STOCK_AGENT_RUNTIME_MODE=agentscope
# STOCK_AGENT_RUNTIME_WORKER_ENABLED=true
# STOCK_AGENT_REDIS_URL=redis://hermes:password@127.0.0.1:6379/0
# STOCK_AGENT_RUN_TIMEOUT_SECONDS=900
# AgentScope AgentLoop hard cap is 50. Lower this per deployment when needed.
# STOCK_AGENT_LOOP_MAX_ITERATIONS=50
# Stop a loop after the same read-only tool and arguments run this many times.
# STOCK_AGENT_LOOP_DUPLICATE_TOOL_LIMIT=3
# STOCK_AGENT_SHUTDOWN_GRACE_SECONDS=90
# STOCK_AGENT_RUN_MAX_ATTEMPTS=3
# STOCK_AGENT_WORKER_CONCURRENCY=4
# STOCK_AGENT_USER_ACTIVE_LIMIT=2
# STOCK_AGENT_QUEUE_LIMIT=500
# STOCK_AGENT_LOCK_TTL_SECONDS=60
# STOCK_AGENT_EVENT_RETENTION_DAYS=14
# STOCK_TOOL_WORKER_CONCURRENCY=4
# STOCK_TOOL_EXTERNAL_EXECUTION_ENABLED=true
# STOCK_TOOL_WORKER_LEASE_SECONDS=60
# STOCK_TOOL_RESULT_WAIT_SECONDS=620
# STOCK_ARTIFACT_VERSION_LIMIT=50
# Keep JWT signatures stable across restarts. Use a random value of at least 32 characters.
STOCK_AUTH_SECRET=
# Normal browser-session login: 24 hours. "Remember login": 30 days.
STOCK_AUTH_TOKEN_TTL_HOURS=24
STOCK_AUTH_REMEMBER_TOKEN_TTL_DAYS=30
# 登录令牌与暴力破解防护
# STOCK_AUTH_TOKEN_TTL_HOURS=24
# STOCK_AUTH_REMEMBER_TOKEN_TTL_DAYS=30
# STOCK_AUTH_LOGIN_MAX_ATTEMPTS=8
# STOCK_AUTH_LOGIN_WINDOW_SECONDS=900
# STOCK_SCHEDULER_SHUTDOWN_GRACE_SECONDS=60

# External-agent MCP endpoint (/api/mcp/): restrict hosts and browser origins.
# Credentials are user-owned tokens created via /api/mcp-tokens, not env secrets.
# STOCK_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,shijingxuan.com
# STOCK_MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*,https://shijingxuan.com

# Mobile web page linked from Feishu pushes (/api/share/{id}): the card button is added only when
# STOCK_PUBLIC_BASE_URL is set; without it pushes stay exactly as they were.
# STOCK_PUBLIC_BASE_URL=https://shijingxuan.com
# STOCK_SHARE_TTL_DAYS=30

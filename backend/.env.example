STOCK_DB_HOST=127.0.0.1
STOCK_DB_PORT=3306
STOCK_DB_USER=root
STOCK_DB_PASSWORD=
STOCK_DB_NAME=hermes-stock
STOCK_DB_ECHO=false
STOCK_CORS_ORIGINS=*

# Optional full SQLAlchemy URL. If set, it overrides STOCK_DB_*.
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/hermes-stock?charset=utf8mb4

# Initial admin bootstrap (NOT hardcoded). An initial super_admin is created only when
# BOTH are set here AND the users table is empty. Leave unset to create no default account.
# STOCK_ADMIN_USERNAME=
# STOCK_ADMIN_PASSWORD=

# Encryption key for Feishu webhook URL/secret at rest (recommended: a long random string).
# If unset, a key is derived from STOCK_AUTH_SECRET / DB password as a fallback.
# STOCK_WEBHOOK_ENC_KEY=

# Daily-rhythm scheduler. Server timezone should be Asia/Shanghai; deploy with a single uvicorn worker.
# STOCK_SCHEDULER_ENABLED=true
# STOCK_SCHEDULER_TICK_SECONDS=30
# Comma-separated CN market holidays (YYYY-MM-DD) that suppress intraday/trading-day-only jobs.
# STOCK_HOLIDAYS=2026-01-01,2026-02-16,2026-02-17

# Vector-memory embeddings (decoupled from the chat LLM). If unset, memory falls back to the
# active LLM provider's /embeddings; if that provider has no embeddings endpoint, memory
# gracefully disables. Point these at any OpenAI-compatible /embeddings service, e.g. SiliconFlow.
# STOCK_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# STOCK_EMBEDDING_API_KEY=
# STOCK_EMBEDDING_MODEL=BAAI/bge-m3
# Optional reranker for memory retrieval (recall -> rerank). Reuses the embedding base_url/api_key
# (same provider's /rerank endpoint). Leave empty to disable reranking.
# STOCK_RERANK_MODEL=BAAI/bge-reranker-v2-m3

[Unit]
Description=SixRabbits Stock public API replica A
After=network-online.target docker.service
Wants=network-online.target docker.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/hermes-stock/current
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/hermes-stock/redis/connection.env
Environment=STOCK_BACKGROUND_SERVICES_ENABLED=false
Environment=STOCK_AGENT_RUNTIME_WORKER_ENABLED=false
ExecStart=/opt/hermes-stock/venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 18080 --timeout-graceful-shutdown 120
CPUWeight=200
IOWeight=200
Restart=always
RestartSec=1
TimeoutStopSec=130
KillMode=mixed

[Install]
WantedBy=multi-user.target
